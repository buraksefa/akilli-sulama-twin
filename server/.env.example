# .env.example -> init.sh bunu .env olarak kopyalar ve CHANGE_ME yerlerine rastgele değer yazar.
# .env git'e girmez. İçindeki parolaları not etmen gerekirse parola yöneticine koy.

# Sunucunun ev ağındaki sabit IP'si (modemde DHCP rezervasyonu yap). Servisler yalnızca bu IP'ye bağlanır.
LAN_BIND_IP=192.168.1.50
TZ=Europe/Istanbul

INFLUX_ORG=sulama
INFLUX_BUCKET=sulama
INFLUX_USER=admin
INFLUX_PASSWORD=CHANGE_ME
INFLUX_TOKEN=CHANGE_ME

GRAFANA_ADMIN_PASSWORD=CHANGE_ME
API_AUTH_TOKEN=CHANGE_ME

# MQTT kullanıcıları (acl dosyasındaki yetkilerle eşleşir)
MQTT_NODE_USER=sulama
MQTT_NODE_PASS=CHANGE_ME
MQTT_TELEGRAF_USER=telegraf
MQTT_TELEGRAF_PASS=CHANGE_ME
MQTT_OPERATOR_USER=operator
MQTT_OPERATOR_PASS=CHANGE_ME
